{
  "name": "payload-toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' --if-present build",
    "browsers:install": "pnpm --filter @codlume/payload-cms exec playwright install chromium",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "prelint": "pnpm build:packages",
    "prepare": "vp config --no-agent",
    "ready": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:build && pnpm test:pack",
    "services:down": "docker compose -f compose.yaml down --remove-orphans",
    "services:up": "docker compose -f compose.yaml up -d --wait localstack",
    "test:build": "pnpm --filter './packages/*' --if-present test:build && pnpm --filter @codlume/payload-cms test:generated && pnpm --filter @codlume/payload-cms build",
    "test:compat": "node tests/compat/run.mjs",
    "test:e2e": "vp run -r test:e2e",
    "test:integration": "vp run -r test:integration",
    "test:limits": "node tests/limits/run.mjs",
    "test:pack": "pnpm --filter './packages/*' --if-present test:pack",
    "test:unit": "vp run -r test:unit",
    "typecheck": "pnpm build:packages && vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "pkg-pr-new": "0.0.88",
    "vite-plus": "0.2.2"
  },
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
