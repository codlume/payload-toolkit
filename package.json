{
  "name": "payload-toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives",
    "prepare": "vp config --no-agent",
    "prototype:blurhash-admin": "python3 -m http.server 4173 --directory prototypes/blurhash-admin-preview",
    "ready": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "vp run -r test:e2e",
    "test:integration": "vp run -r test:integration",
    "test:unit": "vp run -r test:unit",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "vite-plus": "0.2.2"
  },
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
