{
  "name": "@codlume/payload-activity",
  "version": "0.0.0",
  "private": true,
  "description": "A Payload CMS plugin that records the admin user who last modified a document.",
  "keywords": [
    "activity",
    "attribution",
    "cms",
    "payload",
    "payloadcms",
    "plugin"
  ],
  "homepage": "https://github.com/codlume/payload-toolkit/tree/main/packages/payload-activity#readme",
  "bugs": {
    "url": "https://github.com/codlume/payload-toolkit/issues"
  },
  "license": "MIT",
  "author": "Codlume",
  "repository": {
    "type": "git",
    "url": "https://github.com/codlume/payload-toolkit.git",
    "directory": "packages/payload-activity"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "test:build": "pnpm build && node --test tests/build/package-contract.test.mjs && vitest run tests/build/client-entry.test.ts",
    "test:unit": "pnpm build && vitest run tests/unit"
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "graphql": "16.14.2",
    "next": "15.4.11",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@payloadcms/ui": ">=3.88.0 <4",
    "payload": ">=3.88.0 <4",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  }
}
